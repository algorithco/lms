# LMS Platform — VPS watchdog secrets (HOST ONLY, never committed).
# Copy to /opt/lms/deploy/secrets/watchdog.env with real values:
#   cp deploy/secrets/watchdog.env.example /opt/lms/deploy/secrets/watchdog.env
#   chmod 600 /opt/lms/deploy/secrets/watchdog.env
# Cron (host, every 5 min):
#   */5 * * * * /usr/bin/python3 /opt/lms/deploy/vps_watchdog.py >>/var/log/lms-watchdog.log 2>&1
WATCHDOG_BOT_TOKEN=
WATCHDOG_CHAT_ID=
# Optional threshold overrides (defaults in deploy/vps_watchdog.py):
# WATCHDOG_SSH_FAIL_10M=50
# WATCHDOG_DISK_PCT=85
# WATCHDOG_LOAD_MULT=2.0
# WATCHDOG_MEM_MIN_MB=400
# WATCHDOG_DELTA_429=200
# WATCHDOG_DELTA_5XX=50
# WATCHDOG_CERT_DAYS=30
