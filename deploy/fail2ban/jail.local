# ============================================================================
# LMS Platform — host fail2ban jails (Phase 1, gap #4)
#
# Install ON THE VPS (not in Docker):
#   sudo apt install fail2ban
#   sudo cp deploy/fail2ban/jail.local /etc/fail2ban/jail.local
#   # adjust logpath below if /opt/lms differs:
#   sudo systemctl enable --now fail2ban
#   sudo fail2ban-client status
#   sudo fail2ban-client status nginx-limit-req
#
# How it works: nginx logs limit_req rejections ("limiting requests...") to
# deploy/logs/error.log (mounted from the container). fail2ban tails that
# file and bans repeat offenders via iptables for 1h.
#
# Tuning (why these numbers):
#   login zone = 10 req/min + burst 5 → a legit user never exceeds ~15 quick
#   hits; maxretry 10 / 10 min catches only sustained hammering.
#   admin zone = 30 req/min; same logic. sshd = stock strict values.
# Unban: sudo fail2ban-client set nginx-limit-req unbanip <IP>
# NEVER ban Cloudflare edge IPs: nginx restores real client IP via
# CF-Connecting-IP (nginx-main.conf), so bans hit attackers, not the CDN.
# ============================================================================

[DEFAULT]
banaction = iptables-multiport
bantime = 1h

[sshd]
enabled = true
port = ssh
filter = sshd
logpath = /var/log/auth.log
maxretry = 5
findtime = 10m
bantime = 1h

[nginx-limit-req]
enabled = true
port = http,https
filter = nginx-limit-req
logpath = /opt/lms/deploy/logs/error.log
maxretry = 10
findtime = 10m
bantime = 1h
