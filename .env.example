# ============================================================================
# LMS Platform — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values

# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://lms_user:lms_password@db:5432/lms_platform

# Redis (Celery broker)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# AI Essay Grading (OpenAI-compatible providers: OpenRouter or Groq)
#
# ESSAY_AI_PROVIDER:
#   auto      (default) — uses whichever provider has a key configured below
#   openrouter          — force OpenRouter (requires OPENROUTER_API_KEY)
#   groq                — force Groq (requires GROQ_API_KEY)
# Keys are NEVER shared across providers (a Groq key sent to OpenRouter
# returns a misleading 401 "Missing Authentication header").
ESSAY_AI_PROVIDER=auto

# OpenRouter: https://openrouter.ai/keys  (free models: .../models?q=free)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
# Generic aliases also accepted: AI_API_KEY / AI_BASE_URL / AI_MODEL
OPENROUTER_AI_MODEL=nvidia/nemotron-3.5-lightning:free
# Ordered fallback chain (tried in sequence when the primary is rate-limited /
# unavailable). Optional — defaults built in. Legacy single OPENROUTER_FALLBACK_MODEL
# is still honored (appended).
OPENROUTER_FALLBACK_MODELS=liquid/lfm-2.5-2.6b:free,nvidia/nemotron-3-super-120b-a12b:free
# Popular free OpenRouter models:
#   - google/gemma-3-27b-it:free (JSON support, no thinking tags)
#   - meta-llama/llama-4-maverick:free
#   - qwen/qwen3-235b-a22b:free (has thinking tags, auto-stripped)

# Groq: https://console.groq.com/keys  (gsk_... prefix)
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_AI_MODEL=llama-3.3-70b-versatile
# Popular Groq models with JSON output support:
#   - llama-3.3-70b-versatile
#   - llama-3.1-8b-instant
#   - gemma2-9b-it

# Optional: force ONE model on either provider (overrides the defaults above)
# ESSAY_AI_MODEL=llama-3.3-70b-versatile
ESSAY_AI_MOCK_MODE=False

# Per-attempt LLM timeout (seconds). Prod default 60. Grading task limits
# (soft 200s / hard 240s) bundan katta bo'lishi shart.
ESSAY_AI_REQUEST_TIMEOUT=60
# Background-thread retry backoff for runserver-only mode
# (CELERY_TASK_ALWAYS_EAGER=True → Celery o'rniga thread). Prod default 5,10,15.
# Local tezlik uchun: 1,2,3. Development settings buni avtomatik 1,2,3 qiladi.
ESSAY_THREAD_RETRY_BACKOFF=5,10,15
# NOTE: .env.example dagi sk-or-v1-your-... / gsk_your-... placeholder kalitlar
# haqiqiy hisoblanmaydi — grading aniq xatolik beradi yoki MOCK_MODE=True da
# mock qaytaradi. Tez lokal test: ESSAY_AI_MOCK_MODE=True yoki bitta tez model
# (masalan OPENROUTER_FALLBACK_MODELS= bo'sh + GROQ kaliti).

# Essay Settings
ESSAY_TARGET_SCALE=75
ESSAY_OFF_TOPIC_SCORE=35
ESSAY_TIME_LIMIT_MINUTES=60

# Telegram Bot
# Get token from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Bot username (without @) — deep links / CTAs / auth
TELEGRAM_BOT_NAME=uz_essaygrader_bot
# Webhook secret — required if TELEGRAM_WEBHOOK_MODE=True (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_MODE=False

TELEGRAM_API_URL=https://api.telegram.org

# Google OAuth (optional)
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/

# Email (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Certificate
CERTIFICATE_SECRET_KEY=change-this-to-a-random-string

# Site URL (for certificate links, etc.)
SITE_URL=http://localhost:8000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# VAPID (Web Push - optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@lms-platform.uz

# Manual payments (card transfer + Telegram receipt verification)
PAYMENT_CARD_NUMBER=4073 4200 3846 0386
PAYMENT_CARD_BANK=Uzum Bank
PAYMENT_CARD_HOLDER=Lobar Mansurova
PAYMENT_ADMIN_USERNAME=rozievkomiljon