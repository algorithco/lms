# ============================================================================
# LMS Platform — PRODUCTION environment variables
#
# Copy to .env.prod and fill in real values:
#   cp .env.prod.example .env.prod
# NEVER commit .env.prod (it is git-ignored).
# ============================================================================

# ---------------------------------------------------------------------------
# Django — REQUIRED
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated, no spaces (main host + admin host):
DJANGO_ALLOWED_HOSTS=grandec.uz,www.grandec.uz,admin.grandec.uz

# Comma-separated HTTPS origins:
DJANGO_CSRF_TRUSTED_ORIGINS=https://grandec.uz,https://www.grandec.uz,https://admin.grandec.uz

# Public site URL (used for certificate links, OpenRouter attribution, ...)
SITE_URL=https://grandec.uz

# ---------------------------------------------------------------------------
# PostgreSQL — REQUIRED
# ---------------------------------------------------------------------------
DB_NAME=lms_platform
DB_USER=lms_user
DB_PASSWORD=change-me-strong-db-password
DB_HOST=db
DB_PORT=5432

# ---------------------------------------------------------------------------
# Redis (Celery broker + Channels channel layer + cache)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=False

# Optional — bounded pool sizes (defaults are sane; raise only if you see
# Redis connection errors under heavy load)
# CELERY_REDIS_MAX_CONNECTIONS=20
# CELERY_BROKER_POOL_LIMIT=10
# CACHE_REDIS_URL=redis://redis:6379/2

# ---------------------------------------------------------------------------
# Email (SMTP) — for password reset etc.
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# ---------------------------------------------------------------------------
# Telegram Bot — set token to enable the bot container
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:AA...your-token-from-@BotFather
# Bot username (without @) — deep links / CTAs / auth
TELEGRAM_BOT_NAME=uz_essaygrader_bot

TELEGRAM_API_URL=https://api.telegram.org

# Secret token for webhook mode (optional; X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=
# Polling (default, recommended) vs Django webhook. Keep False unless you
# explicitly migrate via setup_bot_webhook --domain (then set SECRET too).
TELEGRAM_WEBHOOK_MODE=False

# ---------------------------------------------------------------------------
# Essay AI grading (OpenRouter / Groq — OpenAI-compatible)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
GROQ_API_KEY=gsk_your-groq-key-here
ESSAY_AI_PROVIDER=openrouter
ESSAY_AI_MODEL=
OPENROUTER_AI_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FALLBACK_MODELS=liquid/lfm-2.5-2.6b:free,nvidia/nemotron-3-super-120b-a12b:free
GROQ_AI_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=
ESSAY_AI_REQUEST_TIMEOUT=60
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_SITE_URL=https://grandec.uz
OPENROUTER_APP_NAME=LMS Platform
ESSAY_AI_MOCK_MODE=False
ESSAY_TARGET_SCALE=75
ESSAY_OFF_TOPIC_SCORE=35
ESSAY_TIME_LIMIT_MINUTES=60

# ---------------------------------------------------------------------------
# Certificate anti-fraud secret
# ---------------------------------------------------------------------------
CERTIFICATE_SECRET_KEY=change-me-to-a-random-string

# ---------------------------------------------------------------------------
# CORS — restrict to the real origins
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://grandec.uz,https://www.grandec.uz

# ---------------------------------------------------------------------------
# Google OAuth (optional)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://grandec.uz/api/auth/google/callback/

# ---------------------------------------------------------------------------
# Web Push (VAPID — optional)
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@grandec.uz

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Manual payments (card transfer + Telegram receipt, no gateway)
# ---------------------------------------------------------------------------
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_BANK=
PAYMENT_CARD_HOLDER=
PAYMENT_ADMIN_USERNAME=